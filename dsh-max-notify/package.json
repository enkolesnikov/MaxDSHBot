{
  "name": "dsh-max-notify",
  "version": "1.12.0",
  "description": "DSH → MAX messenger plugin: rc.2-safe webhook, hardened outbound/allowlist, compact UX, briefings, remote control, schedules, GUI settings, zero runtime deps.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./transport": "./lib/transport.mjs",
    "./format": "./lib/format.mjs",
    "./client": "./client/client.js"
  },
  "files": [
    "index.js",
    "lib",
    "certs",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json",
    "client"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js && node --check client/client.js && for f in lib/*.mjs tools/*.mjs; do node --check \"$f\" || exit 1; done"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "external": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enkolesnikov/MaxDSHBot.git",
    "directory": "dsh-max-notify"
  },
  "homepage": "https://github.com/enkolesnikov/MaxDSHBot#readme",
  "bugs": {
    "url": "https://github.com/enkolesnikov/MaxDSHBot/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "max",
    "max-messenger",
    "notifications",
    "remote-control",
    "agent"
  ],
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  }
}
