# Токен бота MAX: business.max.ru -> Чат-боты -> ⋮ -> Настройки -> токен.
# Этот же файл читает плагин через botTokenFile.
MAX_BOT_TOKEN=replace_with_your_max_bot_token

# chat_id получателя (диалог с ботом или групповой чат).
# Узнать: node dsh-max-notify/tools/pair.mjs (нажать Start в диалоге с ботом).
MAX_CHAT_ID=123456789

# Необязательно: базовый URL MAX Bot API.
MAX_API_BASE=https://platform-api2.max.ru

# Необязательно: allowlist получателей (через запятую), fail-closed.
# MAX_ALLOWED_USER_IDS=987654321
# MAX_ALLOWED_CHAT_IDS=123456789
